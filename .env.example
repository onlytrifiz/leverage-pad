# ─────────────────────────────────────────────────────────────────────────────
# leverage-pad — configurazione. Copia in `.env` e riempi i valori.
# `.env` e' gitignored: NON committare mai chiavi/segreti.
# I valori reali di questo progetto (chiave di test, API key Lighter, RPC Alchemy)
# stanno in HANDOFF.secrets.local.md sulla macchina originale (anch'esso gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# ── RPC Robinhood Chain (4663) ───────────────────────────────────────────────
# Pubblico (no key): https://rpc.mainnet.chain.robinhood.com
# Consigliato un endpoint Alchemy/QuickNode per rate-limit migliori (contiene una api-key → segreto).
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# ── SEGRETI (obbligatori per operare) ────────────────────────────────────────
# Deployer: deploya locker/token e paga il gas dei collect. LAUNCHER_PRIVATE_KEY e' un alias.
DEPLOYER_PRIVATE_KEY=
# Master secret: deriva TUTTI i sub-wallet delle coin (HMAC). PERDERLO = perdere i fondi
# dei sub-wallet. Generane uno forte:  openssl rand -hex 32
PERPSPAD_MASTER_SECRET=
# EOA che incassa la quota treasury (21.25% + 25% del profitto perp rientrato).
PERPSPAD_TREASURY=
# Locker deployato (riempi dopo `node deployLocker.js`).
PERPSPAD_LOCKER=
# Opzionale: chiave dedicata al keeper (default = DEPLOYER_PRIVATE_KEY).
PERPSPAD_KEEPER_KEY=

# ── economia (default = allineati al codice reale di perpspad; somma bps = 10000) ─
# perp e' il RESTO esatto; questi tre + creator devono fare 10000.
PERPSPAD_SPLIT_PERP=4250
PERPSPAD_SPLIT_CREATOR=1500
PERPSPAD_SPLIT_TREASURY=2125
PERPSPAD_SPLIT_BUYBACK=2125
PERPSPAD_TP_MASTER_SHARE_BPS=2500        # del profitto perp rientrato: 25% treasury / 75% buyback
PERPSPAD_PERP_WITHDRAW_FLOOR_USD=25      # preleva il profitto da Lighter sopra questa soglia

# ── keeper: guardie operative ────────────────────────────────────────────────
PERPSPAD_TICK_MS=15000
PERPSPAD_MAX_GAS_PRICE_WEI=5000000000    # cap anti-drain sul funding dei sub-wallet
PERPSPAD_WAIT_TIMEOUT_MS=90000
PERPSPAD_BUYBACK_SLIPPAGE_BPS=300        # tolleranza slippage buyback (minOut quotato dal pool)

# ── quote non-USDG (opzionale) ───────────────────────────────────────────────
# Se una coin usa un pair diverso da USDG, serve il suo prezzo USD (TODO: Rialto).
# Esempio: PERPSPAD_PRICE_TSM=180

# ── Lighter (gamba perp, profilo ROBINHOOD) ──────────────────────────────────
# Interprete Python col lighter-sdk installato (vedi lighter/requirements.txt).
PERPSPAD_LIGHTER_PYTHON=python3
# Modo: off (stub) | simulate (dry-run, legge e logga, non invia) | live (opera davvero).
PERPSPAD_LIGHTER_MODE=off
# PERPSPAD_LIGHTER_ENABLED=1 e' un alias di MODE=live (retrocompat).
PERPSPAD_LIGHTER_API_KEY_INDEX=4         # 0-3 riservati a desktop/mobile Lighter
PERPSPAD_LIGHTER_MAX_SLIPPAGE=0.02
# PERPSPAD_LIGHTER_CROSS=1               # margine cross invece di isolated (default isolated)
# PERPSPAD_LIGHTER_PROFILE=robinhood
